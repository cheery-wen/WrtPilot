# WrtPilot first-boot defaults and legacy GHFU configuration migration.
# Fixed firmware source is enforced by the application backend.
# Do not migrate the legacy github_repo option.

CONFIG="wrtpilot"
SECTION="main"
LEGACY_CONFIG="ghfu"
LEGACY_SECTION="main"

DEFAULT_VALID_EXTS=".img .img.gz .bin .tar .itb .trx .chk .dlf .ari"

# Ensure the new UCI section exists.
if ! uci -q get "${CONFIG}.${SECTION}" >/dev/null 2>&1; then
    uci -q set "${CONFIG}.${SECTION}=wrtpilot"
fi

# Read an existing legacy option without importing the old repository.
legacy_value() {
    uci -q get "${LEGACY_CONFIG}.${LEGACY_SECTION}.${1}" 2>/dev/null
}

# Migrate legacy values only when the new option is absent or still
# contains its shipped default. This avoids overwriting most new settings.
migrate_option() {
    option="$1"
    default_value="$2"

    old_value="$(legacy_value "$option")"
    new_value="$(uci -q get "${CONFIG}.${SECTION}.${option}" 2>/dev/null)"

    if [ -n "$old_value" ]; then
        if [ -z "$new_value" ] || [ "$new_value" = "$default_value" ]; then
            uci -q set "${CONFIG}.${SECTION}.${option}=${old_value}"
        fi
    fi
}

# Preserve safe user preferences from the previous GHFU configuration.
# github_repo, selected_release and automatic-upgrade settings are excluded.
# The legacy selected_release value may have been set during download selection,
# not after a successful firmware flash.
migrate_option "keep_config" "1"
migrate_option "fetch_timeout" "15"
migrate_option "filter_ext_enabled" "1"
migrate_option "valid_extensions" "$DEFAULT_VALID_EXTS"

# Set defaults for options that are still missing.
if [ -z "$(uci -q get "${CONFIG}.${SECTION}.keep_config" 2>/dev/null)" ]; then
    uci -q set "${CONFIG}.${SECTION}.keep_config=1"
fi

if [ -z "$(uci -q get "${CONFIG}.${SECTION}.fetch_timeout" 2>/dev/null)" ]; then
    uci -q set "${CONFIG}.${SECTION}.fetch_timeout=15"
fi

if [ -z "$(uci -q get "${CONFIG}.${SECTION}.filter_ext_enabled" 2>/dev/null)" ]; then
    uci -q set "${CONFIG}.${SECTION}.filter_ext_enabled=1"
fi

if [ -z "$(uci -q get "${CONFIG}.${SECTION}.valid_extensions" 2>/dev/null)" ]; then
    uci -q set "${CONFIG}.${SECTION}.valid_extensions=${DEFAULT_VALID_EXTS}"
fi

# Automatic firmware upgrades are disabled by default.
# These settings are not migrated from the legacy GHFU configuration.
if [ -z "$(uci -q get "${CONFIG}.${SECTION}.auto_upgrade_enabled" 2>/dev/null)" ]; then
    uci -q set "${CONFIG}.${SECTION}.auto_upgrade_enabled=0"
fi

# Do not assign a default execution time. The user must choose one in LuCI.
# Preserve an existing user-selected time.
if [ -z "$(uci -q get "${CONFIG}.${SECTION}.auto_upgrade_time" 2>/dev/null)" ]; then
    uci -q set "${CONFIG}.${SECTION}.auto_upgrade_time="
fi

uci -q commit "$CONFIG"

# Preserve the previous firmware flash timestamp when available.
# Otherwise record the current first-boot timestamp.
NEW_EPOCH="/etc/wrtpilot_flash_epoch"
OLD_EPOCH="/etc/ghfu_flash_epoch"

if [ ! -s "$NEW_EPOCH" ]; then
    if [ -s "$OLD_EPOCH" ]; then
        cp "$OLD_EPOCH" "${NEW_EPOCH}.tmp" &&
            mv "${NEW_EPOCH}.tmp" "$NEW_EPOCH"
    else
        date +%s > "${NEW_EPOCH}.tmp" &&
            mv "${NEW_EPOCH}.tmp" "$NEW_EPOCH"
    fi
fi

# Remove the old unconditional daily automatic-upgrade task.
# The task will only be registered later when the user enables it.
CRONTAB="/etc/crontabs/root"
AUTO_TASK="0 0 * * * lua /usr/libexec/wrtpilot-auto-upgrade"

if [ -f "$CRONTAB" ]; then
    awk -v task="$AUTO_TASK" '$0 != task' "$CRONTAB" > "${CRONTAB}.wrtpilot.tmp" &&
        cat "${CRONTAB}.wrtpilot.tmp" > "$CRONTAB"
    rm -f "${CRONTAB}.wrtpilot.tmp"
fi

exit 0
